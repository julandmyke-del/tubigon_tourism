APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080

# Optional local/testing-only credential for the eight Featured Destination Partner accounts.
# Defaults to Partner123! when omitted. Never use this development seeder in production.
DEV_FEATURED_PARTNER_PASSWORD=
DEV_MSME_OWNER_PASSWORD=
APP_TIMEZONE=Asia/Manila

# Local/testing only. The map seeder also refuses this flag in production.
DEV_SEED_PUBLIC_TUBIGON_PLACES=false

# Local/testing only. One-time date-only demo setup for selected controlled
# destinations. The seeder refuses production and never overwrites later staff edits.
FEATURED_DESTINATIONS_TEST_BOOKING=false
FEATURED_DESTINATION_TEST_BOOKING_SLUGS=mundong-sandbar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Port 587 uses SMTP with automatic STARTTLS in this Laravel/Symfony mailer.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Production: use the dedicated Tour Tubigon Gmail account and a Google App
# Password stored only in the deployed server environment. Never commit it.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth web/server client ID used to validate Google ID tokens.
# Never place GOOGLE_CLIENT_SECRET in Flutter or commit it to source control.
GOOGLE_CLIENT_ID=

# SMTP email verification code lifetime and retry limit.
AUTH_VERIFICATION_EXPIRE_MINUTES=10
AUTH_VERIFICATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Development convenience for only the exact server-side email allowlist.
# Keep disabled in production. This does not depend on APP_ENV or APP_DEBUG.
DEV_AUTH_ALLOWLIST_BYPASS=false
DEV_AUTH_ALLOWLIST_EMAILS=user@gmail.com,msme@gmail.com,lgu@gmail.com,admin@gmail.com,partner@gmail.com
